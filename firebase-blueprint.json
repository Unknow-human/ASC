{
  "entities": {
    "Review": {
      "title": "Review",
      "description": "A user-submitted review for Africa Sound City",
      "type": "object",
      "properties": {
        "authorName": {
          "type": "string",
          "description": "Name of the review author",
          "maxLength": 100
        },
        "text": {
          "type": "string",
          "description": "The review text",
          "maxLength": 1000
        },
        "rating": {
          "type": "number",
          "description": "Rating out of 5",
          "minimum": 1,
          "maximum": 5
        },
        "status": {
          "type": "string",
          "description": "Status of the review: pending, approved, rejected",
          "enum": ["pending", "approved", "rejected"]
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp of creation",
          "format": "date-time"
        },
        "uid": {
          "type": "string",
          "description": "UID of the user who created it"
        }
      },
      "required": ["authorName", "text", "rating", "status", "createdAt", "uid"]
    }
  },
  "firestore": {
    "reviews/{reviewId}": {
      "schema": {
        "$ref": "#/entities/Review"
      },
      "description": "Collection of all submitted reviews"
    }
  }
}
