rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} { 
      allow read, write: if false; 
    }

    // Phase 3: Primitives
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\\\-]+$'); 
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    // Only the explicit app admin if any, for now let's say hardcoded or no admin yet.
    // For now we'll allow public creation, but reading only approved ones.
    function isAdmin() { 
      // Replace with your real admin identification logic. E.g., exist check.
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); 
    }

    // Validation Blueprint for Review
    function isValidReview(data) {
      return data.keys().hasAll(['authorName', 'text', 'rating', 'status', 'createdAt', 'uid'])
          && data.keys().size() == 6
          && data.authorName is string && data.authorName.size() > 0 && data.authorName.size() <= 100
          && data.text is string && data.text.size() > 0 && data.text.size() <= 1000
          && data.rating is number && data.rating >= 1 && data.rating <= 5
          && data.status is string && data.status in ['pending', 'approved', 'rejected']
          && data.uid == request.auth.uid;
    }

    match /reviews/{reviewId} {
      // Only approved reviews can be listed publicly. Or logged in users can read their own.
      // Or Admin can read all.
      // But query must include `status == "approved"`.
      allow list: if 
        (existing().status == 'approved') || 
        isAdmin();
      
      allow get: if existing().status == 'approved' || isAdmin() || existing().uid == request.auth.uid;

      // Creation allows users to write pending reviews
      allow create: if isSignedIn() 
                    && isValidId(reviewId)
                    && isValidReview(incoming())
                    && incoming().status == 'pending'  // forced to pending initially
                    && incoming().createdAt == request.time;
      
      // Update only allowed by Admin for now (to approve/reject).
      allow update: if 
        isAdmin() 
        && isValidReview(incoming())
        && isAdminAction();

      // Action based update for admins
      function isAdminAction() {
        return incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);
      }

      allow delete: if isAdmin();
    }
  }
}
